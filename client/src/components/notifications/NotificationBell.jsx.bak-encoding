import { useEffect, useState } from "react";
import { Link } from "react-router-dom";

import { getLoggedInIdentity } from "../../utils/authIdentity";

import {
    getNotifications,
    getUnreadNotificationCount,
    markNotificationAsRead,
} from "../../services/notificationService";

import "./NotificationBell.css";

function NotificationBell() {
    const [notifications, setNotifications] = useState([]);
    const [unreadCount, setUnreadCount] = useState(0);
    const [open, setOpen] = useState(false);

    const identity = getLoggedInIdentity();

    const loadNotifications = async () => {
        if (!identity) return;

        try {
            const [notificationResult, countResult] =
                await Promise.all([
                    getNotifications(identity.type),
                    getUnreadNotificationCount(identity.type),
                ]);

            setNotifications(
                notificationResult.notifications || []
            );

            setUnreadCount(
                countResult.count || 0
            );
        } catch (error) {
            console.error(
                "Notification bell error:",
                error
            );
        }
    };

    useEffect(() => {
        loadNotifications();

        const interval = setInterval(
            loadNotifications,
            30000
        );

        return () => clearInterval(interval);
    }, []);

    const handleNotificationClick = async (
        notification
    ) => {
        try {
            if (!notification.isRead) {
                await markNotificationAsRead(
                    notification._id,
                    identity.type
                );

                setNotifications((current) =>
                    current.map((item) =>
                        item._id === notification._id
                            ? {
                                ...item,
                                isRead: true,
                                readAt: new Date(),
                            }
                            : item
                    )
                );

                setUnreadCount((current) =>
                    Math.max(0, current - 1)
                );
            }
        } catch (error) {
            console.error(
                "Notification read error:",
                error
            );
        }
    };

    const getIcon = (type) => {
        switch (type) {
            case "CONNECTION_REQUEST":
                return "?";

            case "CONNECTION_ACCEPTED":
                return "?";

            case "CONNECTION_REJECTED":
                return "×";

            case "CONNECTION_CANCELLED":
                return "?";

            case "CONNECTION_REMOVED":
                return "-";

            default:
                return "•";
        }
    };

    const formatTime = (date) => {
        const notificationDate =
            new Date(date);

        const now = new Date();

        const difference =
            Math.floor(
                (now - notificationDate) /
                1000
            );

        if (difference < 60) {
            return "Just now";
        }

        if (difference < 3600) {
            return `${Math.floor(
                difference / 60
            )}m ago`;
        }

        if (difference < 86400) {
            return `${Math.floor(
                difference / 3600
            )}h ago`;
        }

        if (difference < 604800) {
            return `${Math.floor(
                difference / 86400
            )}d ago`;
        }

        return notificationDate.toLocaleDateString(
            "en-IN"
        );
    };

    const latestNotifications =
        notifications.slice(0, 5);

    return (
        <div className="notification-bell-wrapper">

            <button
                type="button"
                className={`notification-bell ${
                    open ? "active" : ""
                }`}
                onClick={() =>
                    setOpen((current) => !current)
                }
                aria-label="Notifications"
            >
                <span className="bell-symbol">
                    ?
                </span>

                <span className="bell-icon">
                    ??
                </span>

                {unreadCount > 0 && (
                    <span className="notification-badge">
                        {unreadCount > 99
                            ? "99+"
                            : unreadCount}
                    </span>
                )}
            </button>

            {open && (
                <>
                    <div
                        className="notification-backdrop"
                        onClick={() =>
                            setOpen(false)
                        }
                    />

                    <div className="notification-dropdown">

                        <div className="notification-dropdown-header">
                            <div>
                                <span>
                                    SICR
                                </span>

                                <h3>
                                    Notifications
                                </h3>
                            </div>

                            {unreadCount > 0 && (
                                <strong>
                                    {unreadCount} new
                                </strong>
                            )}
                        </div>

                        {latestNotifications.length ===
                        0 ? (
                            <div className="notification-dropdown-empty">
                                <div>
                                    ??
                                </div>

                                <p>
                                    No notifications yet
                                </p>

                                <span>
                                    New activity will
                                    appear here.
                                </span>
                            </div>
                        ) : (
                            <div className="notification-dropdown-list">

                                {latestNotifications.map(
                                    (notification) => (
                                        <button
                                            type="button"
                                            key={
                                                notification._id
                                            }
                                            className={`notification-preview ${
                                                notification.isRead
                                                    ? "read"
                                                    : "unread"
                                            }`}
                                            onClick={() =>
                                                handleNotificationClick(
                                                    notification
                                                )
                                            }
                                        >
                                            <span className="preview-icon">
                                                {getIcon(
                                                    notification.type
                                                )}
                                            </span>

                                            <span className="preview-content">
                                                <strong>
                                                    {
                                                        notification.title
                                                    }
                                                </strong>

                                                <span>
                                                    {
                                                        notification.message
                                                    }
                                                </span>

                                                <small>
                                                    {formatTime(
                                                        notification.createdAt
                                                    )}
                                                </small>
                                            </span>

                                            {!notification.isRead && (
                                                <span className="preview-dot" />
                                            )}
                                        </button>
                                    )
                                )}

                            </div>
                        )}

                        <Link
                            to="/notifications"
                            className="view-all-notifications"
                            onClick={() =>
                                setOpen(false)
                            }
                        >
                            View all notifications
                            <span>?</span>
                        </Link>

                    </div>
                </>
            )}

        </div>
    );
}

export default NotificationBell;
