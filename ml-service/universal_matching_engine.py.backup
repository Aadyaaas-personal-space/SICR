    # ============================================================
# SEMANTIC GLOBAL SEARCH
# ============================================================

def semantic_search(query, candidate_profiles, top_n=10):
    """
    Semantic global search across all SICR ecosystem profiles.

    The user's search query is converted into an embedding and
    compared against every candidate profile using cosine similarity.
    """

    if not query or not str(query).strip():
        return []

    if not isinstance(candidate_profiles, list):
        return []

    query_text = normalize_text(query)

    if not query_text:
        return []

    # Generate embedding for the search query
    query_embedding = generate_embedding(query_text)

    results = []

    for index, candidate in enumerate(candidate_profiles):

        try:
            if not isinstance(candidate, dict):
                continue

            # Convert candidate into normalized semantic text
            candidate_text = build_profile_text(candidate)

            if not candidate_text.strip():
                continue

            # Generate candidate embedding
            candidate_embedding = generate_embedding(candidate_text)

            # Calculate semantic similarity
            similarity = float(
                np.dot(query_embedding, candidate_embedding)
            )

            # Keep similarity within safe range
            similarity = max(-1.0, min(1.0, similarity))

            results.append({
                "candidateIndex": index,
                "similarity": round(similarity, 6),
                "matchPercentage": round(
                    max(0.0, similarity) * 100,
                    2
                ),
                "profile": candidate
            })

        except Exception as error:
            print(
                f"Semantic search skipped candidate {index}:",
                repr(error)
            )

    # Highest semantic similarity first
    results.sort(
        key=lambda item: item["similarity"],
        reverse=True
    )

    try:
        top_n = int(top_n)
    except (TypeError, ValueError):
        top_n = 10

    if top_n < 1:
        top_n = 1

    return results[:top_n]